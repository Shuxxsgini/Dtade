# ---------- Products (Step 2) ----------
PRODUCTS = "/api/admin/products"


def _new_product(category_id: int, **overrides) -> dict:
    """A valid product form; pass overrides to break one field on purpose."""
    data = {"product_name": "Wooden Puzzle", "description": "100-piece puzzle",
            "category_id": category_id, "price": "499.00", "available_quantity": 25,
            "product_url": "https://abcshop.com/puzzle"}
    data.update(overrides)                                    # e.g. price="-5"
    return data


def _first_category_id(client) -> int:
    return client.get("/api/categories").json()[0]["category_id"]   # a real seeded category


def test_admin_creates_product(client, login_as):
    r = client.post(PRODUCTS, json=_new_product(_first_category_id(client)), headers=login_as(ADMIN))
    assert r.status_code == 201, r.json()
    assert r.json()["product_name"] == "Wooden Puzzle"
    assert r.json()["category"]["category_id"] == _first_category_id(client)


def test_duplicate_product_is_409(client, login_as):
    headers, cat = login_as(ADMIN), _first_category_id(client)
    client.post(PRODUCTS, json=_new_product(cat), headers=headers)
    r = client.post(PRODUCTS, json=_new_product(cat, product_name="WOODEN puzzle"), headers=headers)
    assert r.status_code == 409


def test_unknown_category_is_404(client, login_as):
    r = client.post(PRODUCTS, json=_new_product(99999), headers=login_as(ADMIN))
    assert r.status_code == 404


def test_bad_price_and_stock_are_422(client, login_as):
    headers, cat = login_as(ADMIN), _first_category_id(client)
    assert client.post(PRODUCTS, json=_new_product(cat, price="-5"), headers=headers).status_code == 422
    assert client.post(PRODUCTS, json=_new_product(cat, price="0"), headers=headers).status_code == 422
    assert client.post(PRODUCTS, json=_new_product(cat, available_quantity=-1), headers=headers).status_code == 422


def test_update_changes_only_sent_fields(client, login_as):
    headers = login_as(ADMIN)
    created = client.post(PRODUCTS, json=_new_product(_first_category_id(client)), headers=headers).json()

    r = client.put(f"{PRODUCTS}/{created['product_id']}", json={"price": "450.00"}, headers=headers)
    assert r.status_code == 200
    body = r.json()
    assert float(body["price"]) == 450.0                          # changed
    assert body["product_name"] == "Wooden Puzzle"                # untouched
    assert body["available_quantity"] == 25                       # untouched


def test_update_unknown_product_is_404(client, login_as):
    assert client.put(f"{PRODUCTS}/99999", json={"price": "10.00"}, headers=login_as(ADMIN)).status_code == 404


def test_rename_to_existing_product_is_409(client, login_as):
    headers = login_as(ADMIN)
    existing_name = client.get("/api/products").json()[0]["product_name"]          # a seeded product
    created = client.post(PRODUCTS, json=_new_product(_first_category_id(client)), headers=headers).json()
    r = client.put(f"{PRODUCTS}/{created['product_id']}", json={"product_name": existing_name}, headers=headers)
    assert r.status_code == 409


def test_support_cannot_manage_products(client, login_as):
    r = client.post(PRODUCTS, json=_new_product(_first_category_id(client)), headers=login_as(SUPPORT))
    assert r.status_code == 403                                   # "no product admin rights"
