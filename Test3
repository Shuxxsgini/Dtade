# ---------- Deactivate (Step 3) ----------
def _create(client, headers) -> int:
    """Create a product as admin and return its id."""
    return client.post(PRODUCTS, json=_new_product(_first_category_id(client)), headers=headers).json()["product_id"]


def test_deactivate_hides_product_from_customers(client, login_as):
    headers = login_as(ADMIN)
    pid = _create(client, headers)

    r = client.delete(f"{PRODUCTS}/{pid}", headers=headers)
    assert r.status_code == 200
    assert r.json()["is_active"] is False

    assert client.get(f"/api/products/{pid}").status_code == 404                       # details hidden
    assert pid not in [p["product_id"] for p in client.get("/api/products").json()]     # list hidden


def test_cannot_add_inactive_product_to_cart(client, login_as, auth_headers):
    headers = login_as(ADMIN)
    pid = _create(client, headers)
    client.delete(f"{PRODUCTS}/{pid}", headers=headers)
    r = client.post("/api/cart/add", json={"product_id": pid, "quantity": 1}, headers=auth_headers)
    assert r.status_code == 404


def test_checkout_refuses_product_deactivated_after_adding(client, login_as, auth_headers):
    headers = login_as(ADMIN)
    pid = _create(client, headers)
    client.post("/api/cart/add", json={"product_id": pid, "quantity": 1}, headers=auth_headers)   # in cart first
    client.delete(f"{PRODUCTS}/{pid}", headers=headers)                                          # then switched off
    r = client.post("/api/orders/checkout", json={"payment_method": "UPI"}, headers=auth_headers)
    assert r.status_code == 400


def test_old_orders_keep_deactivated_product(client, login_as, auth_headers):
    headers = login_as(ADMIN)
    pid = _create(client, headers)
    client.post("/api/cart/add", json={"product_id": pid, "quantity": 1}, headers=auth_headers)
    order_id = client.post("/api/orders/checkout", json={"payment_method": "UPI"},
                           headers=auth_headers).json()["order_id"]
    client.delete(f"{PRODUCTS}/{pid}", headers=headers)                                          # switched off later
    assert client.get(f"/api/orders/details/{order_id}", headers=auth_headers).status_code == 200  # receipt intact


def test_reactivate_product(client, login_as):
    headers = login_as(ADMIN)
    pid = _create(client, headers)
    client.delete(f"{PRODUCTS}/{pid}", headers=headers)
    r = client.put(f"{PRODUCTS}/{pid}", json={"is_active": True}, headers=headers)
    assert r.status_code == 200
    assert client.get(f"/api/products/{pid}").status_code == 200                       # back in the shop


def test_deactivate_unknown_product_is_404(client, login_as):
    assert client.delete(f"{PRODUCTS}/99999", headers=login_as(ADMIN)).status_code == 404


def test_support_cannot_deactivate(client, login_as):
    pid = _create(client, login_as(ADMIN))
    assert client.delete(f"{PRODUCTS}/{pid}", headers=login_as(SUPPORT)).status_code == 403
